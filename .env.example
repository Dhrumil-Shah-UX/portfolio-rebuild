GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Required on Vercel for shared limits; optional locally. Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional independent HMAC secret; defaults to the server-side Supabase key.
PORTFOLIO_AI_IDENTITY_SECRET=
ANALYTICS_ENABLED=true
PORTFOLIO_AI_DAILY_LIMIT=100
PORTFOLIO_AI_WARNING_PERCENT=90
PORTFOLIO_AI_REQUESTS_PER_MINUTE=5
PORTFOLIO_AI_REQUESTS_PER_HOUR=30
PORTFOLIO_AI_CHAT_DAILY_LIMIT=20
PORTFOLIO_AI_JD_DAILY_LIMIT=3
PORTFOLIO_AI_ATTEMPTS_PER_MINUTE=30
PORTFOLIO_AI_ATTEMPTS_PER_HOUR=120
PORTFOLIO_AI_DUPLICATE_WINDOW_SECONDS=30
PORTFOLIO_AI_CACHE_TTL_SECONDS=3600
